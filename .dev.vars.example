# Copy to .dev.vars for `wrangler dev`, or set each with `wrangler secret put`.


# Optional: restrict bounty-registry writes (POST /api/bounties) with a bearer.
# When unset, the route is open (fine for a sandbox demo).
ADMIN_TOKEN=

# Optional: signed-agent identity for writing payout receipts back to the
# forge as commit statuses (POST /dg/status). Generate with
#   node scripts/gen-agent-key.mjs
# then register the printed pubkey via POST /api/agents.
DG_AGENT_DID=
DG_AGENT_KEY_PKCS8_B64=
# IPFS (optional — ciphertext + evidence pinning; degraded when unset)
# IPFS_API_URL=http://127.0.0.1:5001         # self-hosted Kubo RPC
# IPFS_PINNING_URL=                           # any Pinning Service API base
# IPFS_PINNING_KEY=                           # bearer token
