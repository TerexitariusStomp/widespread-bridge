{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "widespread-bridge",
  "account_id": "46966abcfb8f1245ec055842177edcb2",
  "main": "src/index.ts",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Default claim-log forge for unmapped repos (a delta-git deployment).
    // Per-repo bindings override via the FORGES var: a JSON map of
    // {"owner/repo"|"*": {"type": "deltagit"|..., "base": "https://…"}}.
    "FORGE_BASE": "https://code.widespread.fyi",
    // Repos whose forge claim streams the cron scanner watches for
    // unreviewed work claims (each resolves through FORGES → FORGE_BASE).
    "WATCH_REPOS": "slop/slopdotcash,slop/protocol",
    // NEAR market contract — the on-chain source of truth for /api/markets.
    "NEAR_CONTRACT": "98ae0514a19c52d33f5e037f1705d0cc4f5be8a74adb2c86f9403c8ebbe774c7",
    // Ops account that auto-escrows fiat-funded mirrors (key in
    // NEAR_OPS_SECRET_KEY secret). Testnet demo account.
    "NEAR_OPS_ACCOUNT": "wide-ops-328424.testnet",
    "FUTARCHY_CONTRACT": "foreguild-ft-69240.testnet",
    "HATS_CONTRACT": "intentional-hats-632291.testnet",
    "HATS_ORG": "2",
    "NEAR_RPC_URL": "https://rpc.mainnet.near.org",
    // Protocol revenue treasury — mirror platformBps cuts settle here
    // (contract-side 2% FEE_BPS routes via setFeeSink, same account).
    "CUT_SINK": "wide-mkt-11561.testnet",
    "ORACLE_PUBKEY_HEX": "63077a40e99af271b209478b100bf75d2cd3bc0f971cb8e71b2a72fd342f43f6",
    "ORACLE_ACCOUNT": "50a25bb188de7d898283fe04b5e7786b1027662faef64d5d39a1af12d9758e6b",
    "NEAR_AI_MODEL": "deepseek-ai/DeepSeek-V4.1-Flash-1017",
    // Workers AI model for the adjudicator seat.
    "LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Minimum adjudicator confidence (0..1) required to release a payout.
    "MIN_CONFIDENCE": "0.6",
    // Surge hardening knobs — seconds. Scan sweeps and doc caches are
    // time-bucketed so agent/plugin polling can't amplify work.
    "SCAN_MIN_INTERVAL_S": "300",
    "STATE_TTL_S": "30",
    "MARKETS_TTL_S": "60",
    // Public base URL of this deployment — used for receipt target_urls
    // written back to the forge. Set after first deploy.
    "PUBLIC_BASE": "https://widespread.fyi",
    // Upstream EVM provers — public JSON-RPC endpoints for live tx-receipt
    // verification of golem (Polygon) and hopr (Gnosis) upstream refs.
    "UPSTREAM_GOLEM_RPC": "https://polygon-rpc.com",
    "UPSTREAM_HOPR_RPC": "https://rpc.gnosischain.com",
    "UPSTREAM_BEE_RPC": "https://rpc.gnosischain.com",
    // x402 facilitator — NEAR testnet rail. PAYTO is the ops account that
    // already receives protocol funds; RELAYER_KEYS (secret) is a
    // dedicated implicit account that pays gas — fund it with testnet
    // NEAR from https://docs.near.org/getting-started/faucet until
    // settlement goes live. RATE is a demo USDC-per-NEAR quote.
    "X402_PAYTO": "wide-ops-328424.testnet",
    "X402_USDC_PER_NEAR": "0.5",
    "X402_NETWORK": "near:testnet"
  },
  "kv_namespaces": [
    {
      "binding": "CLAIMS",
      "id": "8b4e482c9fe045da900792b76fbbc846"
    }
  ],
  // CoordinatorDO — volunteer-compute pool (LocalChimera port). Volunteer
  // nodes connect via /api/nodes (ws); jobs via /api/jobs.
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "CoordinatorDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CoordinatorDO"] }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Analytics Engine for /api/ops/usage metrics — requires enabling
  // Analytics Engine on the account once (free):
  //   dash → Workers → Analytics Engine → Enable
  // Uncomment after enabling; code degrades gracefully without the binding.
  "analytics_engine_datasets": [
    { "binding": "widespread", "dataset": "Widespread" }
  ],
  // Juror + claim-stream scan every 5 min. Free tier allows 5 cron
  // triggers/account — if the deploy below fails on the trigger limit,
  // the dashboard's /api/state polling still drives the same scan.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Primary domain — everything (MCP, A2A, feed, case files, jury) serves
  // directly off widespread.fyi. Uncomment once the zone is added to this
  // Cloudflare account (dash → Add site → change nameservers at registrar).
  // "routes": [
  //   { "pattern": "widespread.fyi", "custom_domain": true },
  //   { "pattern": "www.widespread.fyi", "custom_domain": true },
  // ],
}
