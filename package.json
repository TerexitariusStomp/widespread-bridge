{
  "name": "widespread-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Verified-work markets, agent-to-human: forge attestations -> AI adjudication -> NEAR escrow release",
  "type": "module",
  "workspaces": [
    "widespread-discovery"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "seed:claim": "node scripts/ship-claim.mjs",
    "seed:bounty": "node scripts/seed-bounty.mjs",
    "test": "vitest run",
    "test:discovery": "npm test -w widespread-discovery",
    "test:all": "npm run sync:check && npm test && npm run test:discovery",
    "sync": "node scripts/sync-surfaces.mjs",
    "sync:check": "node scripts/sync-surfaces.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:earn": "node scripts/earn-loop-test.mjs",
    "wsd": "node widespread-discovery/src/cli.mjs",
    "licenses": "npx --yes license-checker@25 --summary --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Unlicense;CC0-1.0\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.150.0"
  },
  "dependencies": {
    "@ar-agents/ap2": "^0.3.1",
    "@atproto/api": "^0.31.2",
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.26",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@x402/core": "^2.31.0",
    "@x402/near": "^2.31.0",
    "chainsig.js": "^1.1.16",
    "elo-rank": "^1.0.4",
    "masto": "^8.0.0",
    "metascraper": "^5.58.6",
    "ml-logistic-regression": "^2.0.0",
    "natural": "^8.2.6",
    "nostr-tools": "^2.26.0",
    "rss-parser": "^3.13.0",
    "satori": "^0.63.2",
    "viem": "^2.57.17",
    "zod": "^4.6.7"
  }
